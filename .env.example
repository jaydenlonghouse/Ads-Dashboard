# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Client (Vite — exposed in the browser bundle) ---

# Set to true for mock data + no login (local UI dev only)
VITE_USE_MOCK=false

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Workspace domain allowed to sign in
VITE_ALLOWED_EMAIL_DOMAIN=longhouse.co

# Tools Hub integration — slug must match Manage Tools in the hub
VITE_TOOL_SLUG=ads-dashboard
VITE_HUB_URL=http://localhost:5173

# Ask a Question — Gmail compose recipient and subject
VITE_QUESTION_EMAIL_TO=
VITE_QUESTION_EMAIL_SUBJECT=Advertising Data Question

# First day with reporting data (YYYY-MM-DD)
VITE_DATA_EARLIEST_DATE=2026-02-07

# --- Server only (Vercel API routes / `vercel dev` — NOT prefixed with VITE_) ---
# Do not set VITE_AIRTABLE_PAT on production Vercel.

AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Longhouse Advertising Metrics
AIRTABLE_DEALS_TABLE_NAME=Deals

# Same values as VITE_SUPABASE_* (used to verify JWT in /api routes)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Optional override (default: longhouse.co)
ALLOWED_EMAIL_DOMAIN=longhouse.co
